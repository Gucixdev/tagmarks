{
  "manifest_version": 2,
  "name": "tagmarks",
  "version": "0.2.0",
  "description": "One extension: tagged bookmarks and tab sessions in a tree you can search, plus switchable modules (cookie autodelete, dark pages, tracker block, idle tab unloading).",
  "permissions": ["bookmarks", "storage", "tabs", "cookies", "webRequest", "webRequestBlocking", "alarms", "<all_urls>"],
  "browser_specific_settings": { "gecko": { "id": "tagmarks@example.invalid", "strict_min_version": "115.0" } },
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "sidebar_action": { "default_title": "tagmarks", "default_panel": "sidebar.html", "open_at_install": true },
  "commands": { "_execute_sidebar_action": { "suggested_key": { "default": "Alt+B" } } }
}
